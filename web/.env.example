# Copy this file to .env and fill in real values.
# Never commit .env.

# Stellar network to connect to: TESTNET or MAINNET
VITE_STELLAR_NETWORK=TESTNET

# RPC endpoint for the chosen network
VITE_RPC_URL=https://soroban-testnet.stellar.org

# Deployed escrow contract address
VITE_ESCROW_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# SAC token address to use for deliveries
VITE_TOKEN_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
